#!/bin/sh
#
# Model file to setup .env
#
#     EVERY parameter below must be filled appropriately in order to have adequate execution of main.sh 
#
# About them:
#  SMTP_MAIL_RECEIVER     -> An email address
#  SMTP_MAIL_SENDER       -> An email address from GMail
#  SMTP_RELAY_CREDENTIALS -> GMail's Relay login + ':' + its password
#  SNMPV3_AUTHPASS        -> SNMPv3 agent's authentication passphrase
#  SNMPV3_AUTHTYPE        -> SNMPv3 agent's authentication algorithm type
#  SNMPV3_MAIL            -> SNMPv3 agent's admin email address
#  SNMPV3_PRIVPASS        -> SNMPv3 agent's Privacy passphrase
#  SNMPV3_PRIVTYPE        -> SNMPv3 agent's Privacy algorithm type
#  SNMPV3_USER            -> SNMPv3 agent's user
#
SMTP_MAIL_RECEIVER='rcpt@mail.com'
SMTP_MAIL_SENDER='from@mail.com'
SMTP_RELAY_CREDENTIALS='user_relay@gmail.com:password'
SNMPV3_AUTHPASS='auth-password'
SNMPV3_AUTHTYPE='SHA-256'
SNMPV3_MAIL='snmp@mail.com'
SNMPV3_PRIVPASS='priv-password'
SNMPV3_PRIVTYPE='AES-256'
SNMPV3_USER='user_snmp'
